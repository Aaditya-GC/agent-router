# Copy to .env and fill in
PORT=4000
UPSTREAM_BASE_URL=https://tokenharbor.ai/v1
# Optional: protects your router. Opencode will send this as its Bearer key.
# If empty, router is open (fine for localhost-only personal use).
ROUTER_API_KEY=
# Optional: encrypts stored upstream keys at rest. Set a long random string.
ROUTER_SECRET=
# Bulk keys (optional): comma- or newline-separated, `alias=key` or bare key.
# Easiest is data/keys.txt instead — same format, one per line.
HARBOR_KEYS=
# round-robin | failover | least-errors
STRATEGY=round-robin
# Harbor rejects request bodies over ~1.6MB (misreported as context_length_exceeded).
# The router drops the oldest images to fit under this many bytes.
MAX_REQUEST_BYTES=1500000
