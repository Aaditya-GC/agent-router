{
  "name": "agent-router",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Token Harbor key-rotating proxy (OpenAI-compatible) for opencode & other harnesses",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
